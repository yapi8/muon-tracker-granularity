# vis.mac - produces a Geant4 viewer image of the detector and one muon track
# Put this file in C:\MuonTracker\  and run:   MuonTracker.exe 16 0 vis
#
# If the OGL driver is not available in your Geant4 build, comment out the
# /vis/open OGL line and use the VRML2FILE line instead; that writes
# g4_00.wrl, which you can open in a free VRML viewer.

/control/verbose 0
/run/verbose 0

# ---- open a viewer -------------------------------------------------
/vis/open OGL 900x900-0+0
# /vis/open VRML2FILE

# ---- camera --------------------------------------------------------
/vis/viewer/set/viewpointThetaPhi 72 25 deg
/vis/viewer/set/upVector 0 0 1
/vis/viewer/zoom 1.4
/vis/viewer/set/projection perspective 35 deg
/vis/viewer/set/background white
/vis/viewer/set/autoRefresh false

# ---- draw the geometry ---------------------------------------------
/vis/drawVolume
/vis/viewer/set/style surface
/vis/viewer/set/hiddenMarker true
/vis/viewer/set/lineSegmentsPerCircle 48

# make the world wireframe-invisible so only the plates show
/vis/geometry/set/visibility World 0 false

# scintillator plates: light blue, semi-transparent
/vis/geometry/set/colour Scintillator 0 0.45 0.60 0.75 0.35
/vis/geometry/set/forceSolid Scintillator 0 true

# ---- trajectories ---------------------------------------------------
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set mu- red
/vis/modeling/trajectories/drawByParticleID-0/setDefault grey
/vis/modeling/trajectories/drawByParticleID-0/set e- cyan
/vis/scene/endOfEventAction accumulate

# ---- hit points ------------------------------------------------------
/vis/scene/add/hits

# ---- annotations -----------------------------------------------------
/vis/scene/add/scale 20 cm z 1 0 0 manual 0 0 0 m
/vis/scene/add/text 0 0 62 cm 14 0 0 N = 16 layers
/vis/scene/add/axes 0 0 0 15 cm

# ---- fire a small number of muons so one clean track is visible -----
/vis/viewer/set/autoRefresh true
/run/beamOn 3
